  "service": {
    "port": 1026,
    "data_dir": {
      "per": "shared"
    },
    "run": {
      "bin": "mailpit",
      "args": [
        "--smtp",
        "127.0.0.1:{{port}}",
        "--listen",
        "127.0.0.1:8025",
        "--database",
        "{{data_dir}}/mailpit.db"
      ]
    },
    "health": {
      "probe": "tcp",
      "timeout": 30
    },
    "stop": {
      "signal": "term",
      "grace": 10,
      "kill_safe": true
    }
  }
