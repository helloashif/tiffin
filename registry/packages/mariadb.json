  "service": {
    "port": 3306,
    "data_dir": {
      "per": "minor"
    },
    "configs": [
      {
        "name": "my.cnf",
        "template": "# Generated by tiffind before every start: changes here are lost.\n# Put your own settings in conf.d/*.cnf.\n[mysqld]\nbasedir=\"{{install_dir}}\"\ndatadir=\"{{data_dir}}\"\nport={{port}}\nbind-address=127.0.0.1\nsocket=\"{{run_dir}}/mariadbd.sock\"\npid-file=\"{{run_dir}}/mariadbd.pid\"\nskip-name-resolve\ninit-file=\"{{conf_dir}}/init.sql\"\ncharacter-set-server=utf8mb4\n!includedir {{conf_dir}}/conf.d\n"
      },
      {
        "name": "init.sql",
        "template": "CREATE USER IF NOT EXISTS 'root'@'127.0.0.1';\nGRANT ALL ON *.* TO 'root'@'127.0.0.1' WITH GRANT OPTION;\nCREATE USER IF NOT EXISTS 'root'@'::1';\nGRANT ALL ON *.* TO 'root'@'::1' WITH GRANT OPTION;\n"
      }
    ],
    "init": {
      "bin": "mariadb-install-db",
      "args": [
        "--no-defaults",
        "--basedir={{install_dir}}",
        "--datadir={{data_dir}}",
        "--auth-root-authentication-method=normal",
        "--skip-test-db"
      ],
      "marker": "mysql"
    },
    "run": {
      "bin": "mariadbd",
      "args": [
        "--defaults-file={{conf_dir}}/my.cnf"
      ]
    },
    "health": {
      "probe": "mysql",
      "timeout": 120
    },
    "stop": {
      "signal": "term",
      "grace": 60,
      "command": {
        "bin": "mariadb-admin",
        "args": [
          "--protocol=tcp",
          "--host=127.0.0.1",
          "--port={{port}}",
          "--user=root",
          "shutdown"
        ]
      }
    },
    "windows": {
      "init": {
        "bin": "mariadb-install-db",
        "args": [
          "--datadir={{data_dir}}"
        ],
        "marker": "mysql"
      },
      "run": {
        "bin": "mariadbd",
        "args": [
          "--defaults-file={{conf_dir}}/my.cnf",
          "--console"
        ]
      }
    },
    "db": {
      "list": {
        "bin": "mariadb",
        "args": [
          "--protocol=tcp",
          "--host=127.0.0.1",
          "--port={{port}}",
          "--user=root",
          "--batch",
          "--skip-column-names",
          "-e",
          "SELECT schema_name FROM information_schema.schemata WHERE schema_name NOT IN ('mysql', 'information_schema', 'performance_schema', 'sys')"
        ]
      },
      "create": {
        "bin": "mariadb",
        "args": [
          "--protocol=tcp",
          "--host=127.0.0.1",
          "--port={{port}}",
          "--user=root",
          "-e",
          "CREATE DATABASE {{database}} CHARACTER SET utf8mb4"
        ]
      },
      "drop": {
        "bin": "mariadb",
        "args": [
          "--protocol=tcp",
          "--host=127.0.0.1",
          "--port={{port}}",
          "--user=root",
          "-e",
          "DROP DATABASE {{database}}"
        ]
      },
      "backup": {
        "bin": "mariadb-dump",
        "args": [
          "--protocol=tcp",
          "--host=127.0.0.1",
          "--port={{port}}",
          "--user=root",
          "--single-transaction",
          "--routines",
          "--triggers",
          "--hex-blob",
          "{{database}}"
        ]
      },
      "restore": {
        "bin": "mariadb",
        "args": [
          "--protocol=tcp",
          "--host=127.0.0.1",
          "--port={{port}}",
          "--user=root",
          "{{database}}"
        ]
      }
    },
    "settings": {
      "file": "10-tiffin.cnf",
      "header": "[mysqld]",
      "line": "{{key}} = {{value}}",
      "reserved": [
        "port",
        "bind_address",
        "basedir",
        "datadir",
        "socket",
        "pid_file",
        "init_file",
        "skip_networking",
        "mysqlx",
        "mysqlx_port",
        "mysqlx_socket",
        "log_error",
        "user",
        "secure_file_priv"
      ]
    }
  }
}
