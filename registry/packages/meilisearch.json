  "service": {
    "port": 7700,
    "data_dir": {
      "per": "minor"
    },
    "run": {
      "bin": "meilisearch",
      "args": [
        "--http-addr",
        "127.0.0.1:{{port}}",
        "--db-path",
        "{{data_dir}}/data.ms",
        "--dump-dir",
        "{{data_dir}}/dumps",
        "--snapshot-dir",
        "{{data_dir}}/snapshots",
        "--env",
        "development",
        "--no-analytics"
      ]
    },
    "health": {
      "probe": "tcp",
      "timeout": 60
    },
    "stop": {
      "signal": "term",
      "grace": 15,
      "kill_safe": true
    }
  }
