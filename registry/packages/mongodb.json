  "service": {
    "port": 27017,
    "data_dir": {
      "per": "major"
    },
    "run": {
      "bin": "mongod",
      "args": [
        "--dbpath",
        "{{data_dir}}",
        "--port",
        "{{port}}",
        "--bind_ip",
        "127.0.0.1",
        "--wiredTigerCacheSizeGB",
        "0.25",
        "--nounixsocket"
      ]
    },
    "health": {
      "probe": "tcp",
      "timeout": 60
    },
    "stop": {
      "signal": "term",
      "grace": 30
    },
    "windows": {
      "run": {
        "bin": "mongod",
        "args": [
          "--dbpath",
          "{{data_dir}}",
          "--port",
          "{{port}}",
          "--bind_ip",
          "127.0.0.1",
          "--wiredTigerCacheSizeGB",
          "0.25"
        ]
      },
      "stop": {
        "signal": "term",
        "grace": 30,
        "command": {
          "bin": "mongosh",
          "args": [
            "--port",
            "{{port}}",
            "--quiet",
            "--norc",
            "--eval",
            "db.getSiblingDB('admin').shutdownServer()"
          ]
        }
      }
    }
  }
}
