  "service": {
    "port": 5432,
    "data_dir": {
      "per": "major"
    },
    "configs": [
      {
        "name": "postgresql.conf",
        "template": "# Generated by tiffind before every start: changes here are lost.\n# Put your own settings in conf.d/*.conf.\nlisten_addresses = '127.0.0.1'\nport = {{port}}\nunix_socket_directories = ''\nhba_file = '{{conf_dir}}/pg_hba.conf'\nident_file = '{{data_dir}}/pg_ident.conf'\nlogging_collector = off\ninclude_dir = '{{conf_dir}}/conf.d'\n"
      },
      {
        "name": "pg_hba.conf",
        "template": "# Generated by tiffind: loopback connections only, no password.\nhost all all 127.0.0.1/32 trust\nhost all all ::1/128 trust\n"
      }
    ],
    "init": {
      "bin": "initdb",
      "args": [
        "-D",
        "{{data_dir}}",
        "-U",
        "postgres",
        "-A",
        "trust",
        "-E",
        "UTF8",
        "--no-locale",
        "--no-instructions"
      ],
      "marker": "PG_VERSION"
    },
    "run": {
      "bin": "postgres",
      "args": [
        "-D",
        "{{data_dir}}",
        "-c",
        "config_file={{conf_dir}}/postgresql.conf"
      ]
    },
    "health": {
      "probe": "postgres",
      "timeout": 60
    },
    "stop": {
      "signal": "interrupt",
      "grace": 30,
      "command": {
        "bin": "pg_ctl",
        "args": [
          "stop",
          "-D",
          "{{data_dir}}",
          "-m",
          "fast",
          "-w",
          "-t",
          "20"
        ]
      }
    },
    "db": {
      "list": {
        "bin": "psql",
        "args": [
          "-h",
          "127.0.0.1",
          "-p",
          "{{port}}",
          "-U",
          "postgres",
          "-X",
          "-d",
          "postgres",
          "-tA",
          "-c",
          "SELECT datname FROM pg_database WHERE NOT datistemplate"
        ]
      },
      "create": {
        "bin": "createdb",
        "args": [
          "-h",
          "127.0.0.1",
          "-p",
          "{{port}}",
          "-U",
          "postgres",
          "{{database}}"
        ]
      },
      "drop": {
        "bin": "dropdb",
        "args": [
          "-h",
          "127.0.0.1",
          "-p",
          "{{port}}",
          "-U",
          "postgres",
          "{{database}}"
        ]
      },
      "backup": {
        "bin": "pg_dump",
        "args": [
          "-h",
          "127.0.0.1",
          "-p",
          "{{port}}",
          "-U",
          "postgres",
          "--no-owner",
          "--no-privileges",
          "{{database}}"
        ]
      },
      "restore": {
        "bin": "psql",
        "args": [
          "-h",
          "127.0.0.1",
          "-p",
          "{{port}}",
          "-U",
          "postgres",
          "-X",
          "-q",
          "-v",
          "ON_ERROR_STOP=1",
          "-d",
          "{{database}}"
        ]
      }
    },
    "settings": {
      "file": "10-tiffin.conf",
      "line": "{{key}} = '{{value}}'",
      "reserved": [
        "port",
        "listen_addresses",
        "unix_socket_directories",
        "hba_file",
        "ident_file",
        "data_directory",
        "config_file",
        "include",
        "include_dir",
        "include_if_exists",
        "logging_collector",
        "external_pid_file"
      ]
    }
  }
}
