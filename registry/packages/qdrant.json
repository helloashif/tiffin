  "service": {
    "port": 6333,
    "data_dir": {
      "per": "minor"
    },
    "run": {
      "bin": "qdrant",
      "env": {
        "QDRANT__SERVICE__GRPC_PORT": "6334",
        "QDRANT__SERVICE__HOST": "127.0.0.1",
        "QDRANT__SERVICE__HTTP_PORT": "{{port}}",
        "QDRANT__STORAGE__SNAPSHOTS_PATH": "{{data_dir}}/snapshots",
        "QDRANT__STORAGE__STORAGE_PATH": "{{data_dir}}/storage",
        "QDRANT__TELEMETRY_DISABLED": "true"
      }
    },
    "health": {
      "probe": "tcp",
      "timeout": 60
    },
    "stop": {
      "signal": "term",
      "grace": 15,
      "kill_safe": true
    }
  }
