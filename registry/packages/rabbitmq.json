  "service": {
    "port": 5672,
    "data_dir": {
      "per": "minor"
    },
    "configs": [
      {
        "name": "rabbitmq.conf",
        "template": "# Written by Tiffin before every start.\nlisteners.tcp.local = 127.0.0.1:{{port}}\nmanagement.tcp.ip = 127.0.0.1\nmanagement.tcp.port = 15672\nlog.console = true\nlog.console.level = info\nlog.file = false\n"
      },
      {
        "name": "enabled_plugins",
        "template": "[rabbitmq_management].\n"
      }
    ],
    "run": {
      "bin": "rabbitmq-server",
      "env": {
        "ERL_EPMD_ADDRESS": "127.0.0.1",
        "RABBITMQ_BASE": "{{data_dir}}",
        "RABBITMQ_CONFIG_FILE": "{{conf_dir}}/rabbitmq.conf",
        "RABBITMQ_ENABLED_PLUGINS_FILE": "{{conf_dir}}/enabled_plugins",
        "RABBITMQ_LOG_BASE": "{{log_dir}}",
        "RABBITMQ_MNESIA_BASE": "{{data_dir}}",
        "RABBITMQ_NODENAME": "rabbit-{{port}}@localhost",
        "RABBITMQ_NODE_IP_ADDRESS": "127.0.0.1",
        "RABBITMQ_NODE_PORT": "{{port}}",
        "RABBITMQ_PID_FILE": "{{run_dir}}/rabbitmq.pid",
        "RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS": "-kernel inet_dist_use_interface {127,0,0,1}"
      }
    },
    "health": {
      "probe": "tcp",
      "timeout": 120
    },
    "stop": {
      "signal": "term",
      "grace": 30
    },
    "windows": {
      "run": {
        "bin": "rabbitmq-server",
        "env": {
          "ERLANG_HOME": "{{requires_dir}}",
          "ERL_EPMD_ADDRESS": "127.0.0.1",
          "RABBITMQ_BASE": "{{data_dir}}",
          "RABBITMQ_CONFIG_FILE": "{{conf_dir}}/rabbitmq.conf",
          "RABBITMQ_ENABLED_PLUGINS_FILE": "{{conf_dir}}/enabled_plugins",
          "RABBITMQ_LOG_BASE": "{{log_dir}}",
          "RABBITMQ_MNESIA_BASE": "{{data_dir}}",
          "RABBITMQ_NODENAME": "rabbit-{{port}}@localhost",
          "RABBITMQ_NODE_IP_ADDRESS": "127.0.0.1",
          "RABBITMQ_NODE_PORT": "{{port}}",
          "RABBITMQ_PID_FILE": "{{run_dir}}/rabbitmq.pid",
          "RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS": "-kernel inet_dist_use_interface {127,0,0,1}"
        }
      },
      "stop": {
        "signal": "term",
        "grace": 30,
        "command": {
          "bin": "rabbitmqctl",
          "args": [
            "-n",
            "rabbit-{{port}}@localhost",
            "stop"
          ],
          "env": {
            "ERLANG_HOME": "{{requires_dir}}",
            "ERL_EPMD_ADDRESS": "127.0.0.1",
            "RABBITMQ_BASE": "{{data_dir}}",
            "RABBITMQ_CONFIG_FILE": "{{conf_dir}}/rabbitmq.conf",
            "RABBITMQ_CTL_ERL_ARGS": "-kernel inet_dist_use_interface {127,0,0,1}",
            "RABBITMQ_ENABLED_PLUGINS_FILE": "{{conf_dir}}/enabled_plugins",
            "RABBITMQ_LOG_BASE": "{{log_dir}}",
            "RABBITMQ_MNESIA_BASE": "{{data_dir}}",
            "RABBITMQ_NODENAME": "rabbit-{{port}}@localhost",
            "RABBITMQ_NODE_IP_ADDRESS": "127.0.0.1",
            "RABBITMQ_NODE_PORT": "{{port}}",
            "RABBITMQ_PID_FILE": "{{run_dir}}/rabbitmq.pid",
            "RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS": "-kernel inet_dist_use_interface {127,0,0,1}"
          }
        }
      }
    },
    "requires": {
      "package": "erlang",
      "versions": [
        "28",
        "27"
      ]
    }
  }
}
