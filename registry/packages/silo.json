  "service": {
    "port": 9000,
    "data_dir": {
      "per": "shared"
    },
    "run": {
      "bin": "silo",
      "args": [
        "server",
        "--address",
        "127.0.0.1:{{port}}",
        "--console-address",
        "127.0.0.1:9001",
        "--certs-dir",
        "{{conf_dir}}/certs",
        "{{data_dir}}"
      ],
      "env": {
        "MINIO_ROOT_PASSWORD": "tiffin-secret",
        "MINIO_ROOT_USER": "tiffin",
        "MINIO_UPDATE": "off"
      }
    },
    "health": {
      "probe": "tcp",
      "timeout": 60
    },
    "stop": {
      "signal": "term",
      "grace": 15,
      "kill_safe": true
    }
  }
