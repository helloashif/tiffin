  "service": {
    "port": 6379,
    "data_dir": {
      "per": "major"
    },
    "configs": [
      {
        "name": "valkey.conf",
        "template": "# Generated by tiffind before every start: changes here are lost.\n# Put your own settings in conf.d/*.conf.\nbind 127.0.0.1 -::1\nport {{port}}\nprotected-mode yes\ndaemonize no\ndir \"{{data_dir}}\"\npidfile \"{{run_dir}}/valkey.pid\"\nlogfile \"\"\ninclude \"{{conf_dir}}/conf.d/*.conf\"\n"
      }
    ],
    "run": {
      "bin": "valkey-server",
      "args": [
        "{{conf_dir}}/valkey.conf"
      ]
    },
    "health": {
      "probe": "redis",
      "timeout": 30
    },
    "stop": {
      "signal": "term",
      "grace": 30,
      "command": {
        "bin": "valkey-cli",
        "args": [
          "-h",
          "127.0.0.1",
          "-p",
          "{{port}}",
          "shutdown"
        ]
      }
    },
    "settings": {
      "file": "10-tiffin.conf",
      "line": "{{key}} {{value}}",
      "reserved": [
        "port",
        "bind",
        "protected-mode",
        "daemonize",
        "dir",
        "pidfile",
        "logfile",
        "include",
        "unixsocket"
      ]
    }
  }
}
